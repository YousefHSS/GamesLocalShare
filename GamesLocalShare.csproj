<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>

    <!-- Product version stamped into the built exe (keep in sync with installer.iss MyAppVersion).
         Without this the assembly defaults to 1.0.0.0, which then shows on the released files. -->
    <Version>3.0.8</Version>
    <AssemblyVersion>3.0.8.0</AssemblyVersion>
    <FileVersion>3.0.8.0</FileVersion>
    <InformationalVersion>3.0.8</InformationalVersion>
    <Product>Games Local Share</Product>
	  
    
    <!-- Publishing options. Trimming is disabled because BuiltInComInteropSupport (used
         by the embedded WebView), Avalonia's BindingPlugins.DataValidators reflection,
         and reflection-based JsonSerializer overloads all break under the linker.
         SingleFile is also disabled because WebView2's native loader fails to
         initialize under single-file packaging — the window renders pure black even
         though everything else (Avalonia, file I/O, paths) works. Producing a normal
         directory layout is the only configuration where WebView2 actually renders. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from release builds.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <!-- WebView for embedding HTML/React UI -->
    <PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />

    <!-- For JSON configuration parsing (Steam uses VDF but we'll parse it) -->
    <PackageReference Include="Gameloop.Vdf" Version="0.6.2" />
    <!-- For MVVM pattern -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Assets\webui\**" />
  </ItemGroup>

  <!-- Exclude the tests project from the main project's default file globs.
       Without this, the SDK wildcard pulls test source files into the main app. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <AvaloniaResource Remove="tests\**" />
  </ItemGroup>

  <!-- Ensure any icons placed in the Icons folder are copied to the output directory -->
  <ItemGroup>
    <Content Include="Icons\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Controls\" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

  <!-- Build the React UI and embed the freshly-built bundle before the C# build (so the AvaloniaResource
       embed picks up the fresh files). Runs on EVERY build (no Inputs/Outputs) so a WebUI source change can
       never ship a stale UI. vite:singlefile inlines all JS/CSS into index.html, so that one file IS the
       bundle. The build FAILS loudly if npm didn't produce it, rather than silently shipping stale. -->
  <Target Name="BuildWebUI" BeforeTargets="BeforeBuild;BeforeRebuild" Condition="Exists('WebUI\package.json')">
    <Message Importance="high" Text="BuildWebUI: building the React UI (npm run build) …" />
    <Exec Command="npm run build" WorkingDirectory="WebUI" />
    <Error Condition="!Exists('WebUI\dist\index.html')"
           Text="BuildWebUI: WebUI\dist\index.html was not produced — the npm build failed or produced no output." />
    <ItemGroup>
      <_WebUIDist Include="WebUI\dist\**\*.*" />
    </ItemGroup>
    <!-- Always overwrite (no SkipUnchangedFiles) so the embedded resource exactly matches the fresh build. -->
    <Copy SourceFiles="@(_WebUIDist)"
          DestinationFiles="@(_WebUIDist->'Assets\webui\%(RecursiveDir)%(Filename)%(Extension)')"
          OverwriteReadOnlyFiles="true" />
  </Target>

  <ItemGroup>
    <Content Include="Assets\webui\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Proven Xbox MSIXVC transfer scripts. Source of truth lives in
       PLANNING\xbox-validation\auto; these three are copied to the build
       output as xbox-scripts\ and deployed to a writable per-user folder
       at runtime by XboxScriptHost. -->
  <ItemGroup>
    <None Update="PLANNING\xbox-validation\auto\_common.ps1;PLANNING\xbox-validation\auto\xbox-transfer-sender.ps1;PLANNING\xbox-validation\auto\xbox-transfer-receiver-overlay.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>xbox-scripts\%(Filename)%(Extension)</Link>
    </None>
    <!-- Skeleton capture/reconstruct tool (single-copy storage). Bundled the
         same way; deployed and run by SkeletonService. -->
    <None Update="PLANNING\xbox-validation\reconstruct\xskl.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>xbox-scripts\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Bundled xvdtool (on-the-fly decrypt + skeleton capture/reconstruct). The app shells out to
       tools\xvdtool\XVDTool.exe as a separate process (so its deps never load in-process). This is the
       CUSTOM XVDTool fork with the capture/reconstruct/skel/cikfolder skeleton support, published
       framework-dependent (win-x64): XVDTool.exe (~150 KB) + XVDTool.dll + LibXboxOne.dll + DiscUtils/
       BouncyCastle/NDesk deps. The whole folder is copied verbatim to output and packaged recursively by
       the installer. It needs .NET 8 on the target — the same requirement as this app (SelfContained=false).
       DO NOT replace it with a stock/self-contained single-file XVDTool: the upstream build has NO capture
       support and silently fails every capture with "input file doesn't exist" (regressed once in 3ef373c). -->



  <ItemGroup>
    <Content Include="tools\xvdtool\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\xvdtool\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Bundled CikExtractor (derives the device key + dumps the user's own content-instance keys as
       .cik files for xvdtool). Self-contained single-file publish (win-x64), same as xvdtool, so no
       .NET runtime install is needed. Launched elevated by CikExtractorRunner; auto-resolved from
       tools\cikextractor when the user hasn't set an explicit CikExtractorPath. Rebuild with:
       dotnet publish CikExtractor.csproj -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true -->
  <ItemGroup>
    <Content Include="tools\cikextractor\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\cikextractor\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Never treat the bundled tool's files as app sources. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- In-process reference to the bundled LibXboxOne (streaming skeletonizer path). Compile-time ONLY
       (Private=false): the DLL is NOT copied next to the exe. At runtime it and its DiscUtils/BouncyCastle
       deps are resolved lazily from tools\xvdtool by Services.XvdInProcess.EnsureResolver, so there is a
       single copy of these assemblies (shared with the XVDTool.exe subprocess) and they only load when
       streaming capture is actually used. Keep this in sync with the bundled tools\xvdtool\LibXboxOne.dll. -->
  <ItemGroup>
    <Reference Include="LibXboxOne">
      <HintPath>tools\xvdtool\LibXboxOne.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
